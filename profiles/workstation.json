{
  "extraKnownMarketplaces": {
    "loadout": {
      "source": {
        "ref": "main"
      }
    }
  },
  "enabledPlugins": {
    "loadout@loadout": true,
    "bard@loadout": true
  },
  "outputStyle": "bard:peer",
  "cleanupPeriodDays": 120,
  "env": {
    "CLAUDE_CODE_PLUGIN_KEEP_MARKETPLACE_ON_FAILURE": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/plugins/marketplaces/loadout/plugins/loadout/statusline/statusline.sh",
    "padding": 0
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}
