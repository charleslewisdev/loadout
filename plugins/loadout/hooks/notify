#!/usr/bin/env bash
# Desktop notification for the Stop and Notification hooks.
#
#   notify <event text>
#
# Returns an OSC 777 sequence in the hook output's terminalSequence field, which
# Claude Code writes to the terminal itself; plain hook stdout never reaches it.
# Notification payloads carry their own message, which replaces the event text.
IFS=$'\t' read -r cwd message < <(jq -r '[.cwd // "", .message // ""] | @tsv' 2>/dev/null)
project=$(basename "${cwd:-$PWD}")
text=${message:-${1:-done}}
# OSC parameters are separated by ";", and control characters would end the sequence.
clean() { printf '%s' "$1" | tr -d '\000-\037\177' | tr ';' ','; }
jq -nc --arg seq "$(printf '\033]777;notify;%s;%s\033\\' "Claude Code" "[$(clean "$project")] $(clean "$text")")" \
  '{terminalSequence: $seq}'
