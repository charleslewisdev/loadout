#!/usr/bin/env bash
# Stop hook: Claude doesn't finish multi-file work unreviewed. A review that must
# always happen can't be left to a skill description, so the check lives here.
# When a session has changed at least LOADOUT_REVIEW_MIN_FILES (default 2) files
# since its last /loadout:review-party, it blocks the stop and tells Claude to run
# the review. It blocks once per batch of work: a marker per session records how
# many events it has seen, and only new events can block again.
#
# It reads the session transcript and the subagent transcripts beside it, oldest
# event first. Changed files are Edit and Write targets inside the repository that
# still differ from the default branch, and aren't ignored. Edits in
# the same turn as a review are that review's fixes and don't count. Before any
# review, a mutating Bash command counts every file that differs, since the
# transcript doesn't name them.
# LOADOUT_REVIEW_GATE=0 turns the gate off. LOADOUT_CACHE moves the markers.
set -uo pipefail
export LC_ALL=C

[[ ${LOADOUT_REVIEW_GATE:-1} == 0 ]] && exit 0
command -v jq >/dev/null || exit 0
if ! command -v perl >/dev/null; then
  printf '{"systemMessage":"loadout: perl is not installed, so the review gate is off"}\n'
  exit 0
fi
min=${LOADOUT_REVIEW_MIN_FILES:-2}
[[ $min =~ ^[0-9]+$ ]] || min=2
input=$(cat)
[[ $(jq -r '.stop_hook_active // false' <<<"$input") == true ]] && exit 0
transcript=$(jq -r '.transcript_path // empty' <<<"$input")
cwd=$(jq -r '.cwd // empty' <<<"$input")
session=$(jq -r '.session_id // empty' <<<"$input")
[[ -r $transcript && -d $cwd ]] || exit 0
top=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) || exit 0

files=("$transcript")
for f in "${transcript%.jsonl}"/subagents/*.jsonl; do
  [[ -r $f ]] && files+=("$f")
done

# One line per event, as timestamp, tab, event: TURN (a person spoke), REVIEW, BASH
# (a mutating command) or a file path. fromjson? skips a malformed line.
extract='fromjson? |
  (.timestamp // "") as $ts |
  (if .type == "assistant" then
    .message.content[]? | select(.type == "tool_use")
    | if .name == "Skill" and ((.input.skill // "") | test("(^|:)review-party$")) then "REVIEW"
      elif .name == "Edit" or .name == "Write" then .input.file_path // empty
      elif .name == "NotebookEdit" then .input.notebook_path // empty
      elif .name == "Bash" and ((.input.command // "") | test("(^|[;&|\\n]\\s*)git( -[cC] \\S+)* (commit|mv|rm)\\b|(^|[;&|\\n]\\s*)(sed|perl)( -\\S+)* (-[Eenprsal0-9]*i\\S*|--in-place)")) then "BASH"
      else empty end
  elif .type == "user" and (.isSidechain | not) and (.isMeta | not) then
    (.message.content | if type == "string" then . else ([.[]? | select(.type == "text") | .text] | join(" ")) end) as $text
    | select($text != "" and ($text | test("^\\s*<(task-notification|system-reminder)") | not))
    | if ($text | test("<command-name>/?loadout:review-party</command-name>")) then "TURN", "REVIEW" else "TURN" end
  else empty end) | "\($ts)\t\(.)"'
events=$(cat "${files[@]}" | jq -R -r "$extract" 2>/dev/null | sort -s -t $'\t' -k1,1 | cut -f2-)

# Keep what follows the last review, except edits made in the review's own turn.
state=$(awk '
  /^REVIEW$/ { n = 0; delete e; reviewed = 1; fixing = 1; bash = 0; next }
  /^TURN$/ { fixing = 0; next }
  fixing { next }
  /^BASH$/ { bash = 1; next }
  { e[++n] = $0 }
  END { print "reviewed=" reviewed + 0 " bash=" bash + 0; for (i = 1; i <= n; i++) print e[i] }' <<<"$events")
read -r reviewed_kv bash_kv <<<"$(head -1 <<<"$state")"
reviewed=${reviewed_kv#reviewed=}
bash=${bash_kv#bash=}

# Real paths, inside the repository, not ignored, and still different.
# The default branch is the base, so pushing work doesn't hide it; on the default
# branch itself, the upstream is.
base=''
head=$(git -C "$top" rev-parse HEAD 2>/dev/null)
for ref in origin/HEAD origin/main origin/master main master '@{upstream}'; do
  b=$(git -C "$top" merge-base HEAD "$ref" 2>/dev/null) || continue
  base=$b
  [[ $b != "$head" ]] && break
done
differs=$({
  git -C "$top" status --porcelain -z -uall --no-renames 2>/dev/null | tr '\0' '\n' | cut -c4-
  [[ -n $base ]] && git -C "$top" -c core.quotePath=false diff --name-only "$base" HEAD 2>/dev/null
} | sed '/^$/d' | sort -u)
touched=$(tail -n +2 <<<"$state" | sed '/^$/d' |
  perl -MCwd=abs_path -MFile::Basename -lne 'my $d = abs_path(dirname($_)); print defined $d ? "$d/" . basename($_) : $_' |
  grep -F "$top/" | sed "s#^$top/##" | sort -u | comm -12 - <(printf '%s\n' "$differs") |
  while IFS= read -r f; do git -C "$top" check-ignore -q -- "$f" || printf '%s\n' "$f"; done | grep -c .)

changed=$touched
if ((bash && !reviewed)); then
  whole=$(grep -c . <<<"$differs")
  ((whole > changed)) && changed=$whole
fi
((changed >= min)) || exit 0

# Once per batch: only events the last block hadn't seen can block again.
cache=${LOADOUT_CACHE:-$HOME/.cache/loadout}/review-gate
count=$(grep -c -v -e '^TURN$' -e '^$' <<<"$events")
if [[ -n $session ]]; then
  marker=$cache/$session
  last=$(cat "$marker" 2>/dev/null) || last=''
  [[ $last =~ ^[0-9]+$ ]] && ((count <= last)) && exit 0
  mkdir -p "$cache" && printf '%s\n' "$count" >"$marker"
fi

jq -nc --arg n "$changed" '{decision: "block", reason: ($n + " files changed since your last review. Before you report this work as done, run /loadout:review-party on it, fix what it confirms, then report. If you are stopping to ask the user something, say so and stop again.")}'
