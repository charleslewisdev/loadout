#!/usr/bin/env bash
# The harness's measured state, read from the caches the loadout scripts write.
#
#   status [--measure]   --measure re-runs scripts/budget and scripts/memory-reads first
#
# LOADOUT_REPO names the loadout checkout (default: the marketplace clone).
set -uo pipefail

here=$(cd "$(dirname "$0")" && pwd)
config=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
cache=${LOADOUT_CACHE:-$HOME/.cache/loadout}
repo=${LOADOUT_REPO:-$config/plugins/marketplaces/loadout}
deny=${GUARD_DENYLIST:-$HOME/.config/loadout-guard/denylist}
now=$(date +%s)
hints=()
commas() { sed ':a;s/\B[0-9]\{3\}\>/,&/;ta' <<<"$1"; }
field() { sed -n "s/^$1=//p" "$2" 2>/dev/null | head -1; }
# A cached range is "low-high", and the low end can be negative ("-900-2300").
lo() { local v; v=$(field "$1" "$2"); printf '%s' "${v%-*}"; }
hi() { local v; v=$(field "$1" "$2"); printf '%s' "${v##*-}"; }
age() { local e; e=$(field epoch "$1"); [[ $e =~ ^[0-9]+$ ]] && echo "$(((now - e) / 86400)) days ago" || echo "date unknown"; }

if [[ ${1:-} == --measure ]]; then
  echo "Measuring: scripts/budget (about a minute), then scripts/memory-reads."
  "$repo/scripts/budget" >/dev/null 2>&1
  rc=$?
  # scripts/budget exits 1 on a ceiling failure too; only a missing result is an error
  if ((rc > 1)) || ! grep -q '^result=' "$cache/budget" 2>/dev/null; then
    echo "MEASUREMENT FAILED: scripts/budget exited $rc; the numbers below are from the last good run."
    hints+=("Rerun ${repo/#"$HOME"/\~}/scripts/budget in a terminal to see why it failed.")
  fi
  "$repo/scripts/memory-reads" >/dev/null 2>&1 ||
    echo "MEASUREMENT FAILED: scripts/memory-reads exited $?; its line below is from the last good run."
fi

echo "## Turn-0 cost"
b=$cache/budget
if [[ -r $b ]]; then
  range=$(commas "$(lo share "$b")"); [[ $(lo share "$b") != "$(hi share "$b")" ]] && range+=" to $(commas "$(hi share "$b")")"
  echo "Harness share $range tokens against a $(commas "$(field ceiling "$b")") ceiling: $(field result "$b"), measured $(age "$b") on Claude Code $(field claude_version "$b")."
  echo "Vendor floor $(commas "$(lo floor "$b")"); auto-memory section up to $(commas "$(hi automemory "$b")"); MCP servers up to $(commas "$(hi mcp "$b")")."
  if [[ -n $(field listing_chars "$b") ]]; then
    echo "Skill listing: $(field listing_skills "$b") skills, $(commas "$(field listing_chars "$b")") characters against a budget of $(commas "$(field listing_budget "$b")"), so descriptions are cut."
  fi
  [[ $(field result "$b") == pass ]] || hints+=("The harness share is over its ceiling: find the new cost with scripts/budget and cut it before adding anything.")
  e=$(field epoch "$b")
  [[ $e =~ ^[0-9]+$ ]] && ((now - e > 2592000)) && hints+=("The budget is over 30 days old: run /loadout:harness-status --measure.")
else
  echo "Not measured on this machine."
  hints+=("Measure the turn-0 cost: /loadout:harness-status --measure (about a minute).")
fi

echo
echo "## Hooks, last 7 days"
if [[ -x $repo/scripts/hook-report ]]; then
  report=$("$repo/scripts/hook-report" 7)
  echo "$report"
  while read -r hook p95; do
    case $hook in session-start | format) limit=300 ;; notify-*) limit=100 ;; *) continue ;; esac
    awk -v a="$p95" -v b="$limit" 'BEGIN { exit !(a > b) }' &&
      hints+=("$hook is over its p95 budget of $limit ms. A hook over budget for a week is deleted, not tuned (ADR-09).")
  done < <(awk 'NR > 1 { print $1, $4 }' <<<"$report")
else
  echo "scripts/hook-report not found under ${repo/#"$HOME"/\~}."
fi
echo "Budgets at p95: session-start 300 ms, notify 100 ms, format 300 ms."

echo
echo "## Memory indexes"
names=0 over100=0 over200=0 rows=''
# Project names are withheld when they match the denylist, and all of them when
# the denylist is missing, empty or invalid: this report lands in a session.
deny_ok=0
if [[ -s $deny ]]; then
  rc=0
  grep -E -f "$deny" /dev/null || rc=$?
  ((rc <= 1)) && deny_ok=1
fi
for m in "$config"/projects/*/memory/MEMORY.md; do
  [[ -f $m ]] || continue
  names=$((names + 1))
  n=$(wc -l <"$m")
  ((n > 100)) && over100=$((over100 + 1))
  ((n > 200)) && over200=$((over200 + 1))
  p=$(basename "$(dirname "$(dirname "$m")")")
  p=${p//${HOME//\//-}/\~}
  if ((!deny_ok)) || grep -q -i -E -f "$deny" <<<"$p"; then p='(name withheld)'; fi
  rows+="$n"$'\t'"$p"$'\n'
done
echo "$names indexes; $over100 over 100 lines (a retro trigger), $over200 over 200 (the vendor loads only 200)."
((over100 > 0)) && hints+=("$over100 memory indexes are over 100 lines, which triggers a retro; the retro skill arrives in phase 3.")
printf '%s' "$rows" | sort -rn | head -5 | awk -F'\t' '{ printf "  %4d lines  %s\n", $1, $2 }'
[[ -r $cache/memory-reads ]] && sed -n 's/^  reads per session *\(.*\)/Memory reads per interactive session: \1 (scripts\/memory-reads)./p' "$cache/memory-reads"

echo
echo "## Style and plugin"
settings=$config/settings.json
echo "outputStyle: $(jq -r '.outputStyle // "unset"' "$settings" 2>/dev/null). loadout $(jq -r .version "$here/../../.claude-plugin/plugin.json" 2>/dev/null)."
echo "statusLine: $(jq -r '.statusLine.command // "unset"' "$settings" 2>/dev/null | sed "s|$HOME|~|g")"

echo
echo "## Retro"
last=$(ls "$repo"/retros/*.md 2>/dev/null | sort | tail -1)
if [[ -n $last ]]; then
  d=$(basename "$last" .md)
  echo "Last retro $d, $(((now - $(date -d "$d" +%s 2>/dev/null || echo "$now")) / 86400)) days ago. Due every 90 days."
else
  echo "No retro yet. The first is due at the end of phase 3."
fi

echo
echo "## Next"
if ((${#hints[@]})); then printf -- '- %s\n' "${hints[@]}"; else echo "Nothing to do."; fi
