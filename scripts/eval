#!/usr/bin/env bash
# Run a plugin's eval cases with a pinned model and threshold, never publishing.
#
#   scripts/eval <plugin-dir> [claude plugin eval args]
#
# Always passes --no-publish: the CLI publishes the report to claude.ai by default
# when the account supports it, and eval prompts are a publishing surface. It
# refuses --publish-report. Cases that plant fixtures need --scaffold, which stays
# off unless passed. Results land in <plugin-dir>/evals/results/, which git ignores.
# The model is pinned to Sonnet 5; a later --model, such as claude-opus-5-5, wins.
#
# Exits 3 if Bash failed in the eval sandbox, whatever the score says, or if it
# couldn't check: graders see that a command was attempted, so a broken sandbox can
# score 1.0. Only the kept traces show it reliably, so every run keeps them and this
# removes them afterward, unless you passed --keep-temp yourself.
#
# The eval sandbox makes /tmp read-only for Bash, even inside its own allowed paths,
# so the workspace goes under the cache directory, not the default temp directory.
# No reboot clears it, so each start removes workspaces more than a day old.
#
# It has no network either, and project settings can't change PATH, so a command
# that a case needs to fake lives in scripts/eval-bin, which goes first on PATH. It
# can't live under evals/, because the sandbox hides that directory from Bash.
# Version-manager shim directories move to the end of PATH, behind system tools.
set -uo pipefail

if [[ $# -lt 1 || $1 == -* ]]; then
  sed -n '2,24s/^# \{0,1\}//p' "$0" >&2
  exit 2
fi
plugin=$1
shift
keep=0
for arg in "$@"; do
  case $arg in
    --publish-report | --publish-report=*)
      echo "scripts/eval: --publish-report is refused; eval reports stay local" >&2
      exit 2
      ;;
    --keep-temp) keep=1 ;;
  esac
done

out=$(mktemp)
trap 'rm -f "$out"' EXIT
TMPDIR=${XDG_CACHE_HOME:-$HOME/.cache}/loadout/eval-tmp
mkdir -p "$TMPDIR"
export TMPDIR
# No reboot clears this directory, so drop workspaces over a day old. Newer ones may
# belong to a run in progress. find -type d skips symlinks, and sealed/ is mode 000.
while IFS= read -r -d '' dir; do
  chmod -R u+rwx "$dir" 2>/dev/null
  rm -rf "$dir"
done < <(find "$TMPDIR" -mindepth 1 -maxdepth 1 -type d -name 'claude-eval-*' -mmin +1440 -print0)
# Version-manager shims (pyenv, rbenv, asdf) call into the home directory, which
# the sandbox hides, so a shimmed python3 fails there and sends runs off fixing it.
# They move to the end of PATH rather than leaving it, because claude itself, or
# the node it runs on, may resolve only through one.
kept_path= shim_path=
IFS=: read -r -a entries <<<"$PATH"
for entry in "${entries[@]}"; do
  if [[ $entry == */shims || $entry == */shims/ ]]; then
    shim_path+=${shim_path:+:}$entry
  else
    kept_path+=${kept_path:+:}$entry
  fi
done
PATH=$(cd "$(dirname "$0")" && pwd)/eval-bin${kept_path:+:$kept_path}${shim_path:+:$shim_path}
claude plugin eval "$plugin" --no-publish --model claude-sonnet-5 --threshold 0.8 --keep-temp "$@" 2>&1 | tee "$out"
rc=${PIPESTATUS[0]}

broken=0 checked=0
while IFS= read -r dir; do
  [[ -d $dir ]] || continue
  checked=$((checked + 1))
  # sealed/ is mode 000 and holds what the plugin wrote; the traces are in the rest.
  grep -rqs -E -e 'apply-seccomp|bwrap: |/cwd-[0-9a-f]+: Read-only file system|index\.lock.{0,3}: Read-only file system' --exclude-dir=sealed "$dir" && broken=1
  if ((!keep)) && [[ $(basename "$dir") == claude-eval-* && $dir != *..* && ! -L $dir ]]; then
    chmod -R u+rwx "$dir" 2>/dev/null
    rm -rf "$dir"
  fi
  # Anchored: grader lines are indented and can quote anything a plugin wrote.
done < <(sed -n 's/^⚠ kept \(\/[^:]*\): .*/\1/p' "$out")

if ((broken)); then
  echo "scripts/eval: Bash failed in the eval sandbox, so these scores are invalid whatever they say" >&2
  exit 3
fi
if ((checked == 0)) && ! grep -q '^No eval cases found' "$out"; then
  echo "scripts/eval: could not check the sandbox, because no kept trace was found; don't trust these scores" >&2
  exit 3
fi
exit "$rc"
