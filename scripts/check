#!/usr/bin/env bash
# Repository checks. CI runs `scripts/check --ci`, which needs no Claude and no
# network; locally it also validates the marketplace with the CLI.
#
#   scripts/check [--ci]
#
#   1. scripts/lint-budgets
#   2. every plugins/*/ has at least one evals/**/case.yaml
#   3. guard/scan --all: every author and committer email is in
#      guard/allowed-emails, no secret patterns, and the private denylist where
#      it exists (never in CI)
#   4. plugin, marketplace and skill names against guard/forbidden-names
#   5. the statusline, notify, session-start, review gate, gh publication hook and guard/scan tests, and guard/scan --path and retro-evidence on synthetic homes
#   6. install.sh on a synthetic home, scripts/budget and scripts/eval against a stub claude, and vale on published
#      docs where it is installed
#   7. every retro since the audit log began has an entry in docs/audit-log.md
#   8. the machine-checkable items of docs/public-repo-standard.md
#   9. locally only: claude plugin validate .
set -uo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root" || exit 2
ci=0
[[ ${1:-} == --ci ]] && ci=1
failed=()

step() {  # label, command...
  local label=$1
  shift
  echo "== $label"
  "$@" || failed+=("$label")
}

evals_present() {
  local d ok=0
  for d in plugins/*/; do
    if [[ -z $(find "$d" -path '*/evals/*' -name case.yaml -print -quit) ]]; then
      echo "${d%/} has no evals/**/case.yaml"
      ok=1
    fi
  done
  return $ok
}

names_allowed() {
  local ok=0 name rc
  while IFS= read -r name; do
    rc=0
    grep -q -i -E -f <(grep -v -e '^#' -e '^[[:space:]]*$' guard/forbidden-names) <<<"$name" || rc=$?
    if ((rc == 0)); then
      echo "forbidden word in name: $name"
      ok=1
    elif ((rc > 1)); then
      echo "guard/forbidden-names holds an invalid pattern"
      return 1
    fi
  done < <(
    find plugins -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
    find plugins -mindepth 3 -maxdepth 3 -path '*/skills/*' -type d -printf '%f\n'
    jq -r '.name, .plugins[].name' .claude-plugin/marketplace.json
    jq -r '.name' plugins/*/.claude-plugin/plugin.json
  )
  return $ok
}

review_gate_tests() {  # print only the failed assertions, keep the suite's status
  local out rc=0
  out=$(plugins/loadout/hooks/review-gate.test.sh 2>&1) || rc=$?
  ((rc == 0)) || grep '✗' <<<"$out"
  return "$rc"
}

session_start_tests() {  # print only the failed assertions, keep the suite's status
  local out rc=0
  out=$(plugins/loadout/hooks/session-start.test.sh 2>&1) || rc=$?
  ((rc == 0)) || grep '✗' <<<"$out"
  return "$rc"
}

gh_hook_tests() {  # print only the failed assertions, keep the suite's status
  local out rc=0
  out=$(guard/gh-hook.test.sh 2>&1) || rc=$?
  ((rc == 0)) || grep '✗' <<<"$out"
  return "$rc"
}

notify_tests() {  # print only the failed assertions, keep the suite's status
  local out rc=0
  out=$(plugins/loadout/hooks/notify.test.sh 2>&1) || rc=$?
  ((rc == 0)) || grep '✗' <<<"$out"
  return "$rc"
}

statusline_tests() {  # print only the failed assertions, keep the suite's status
  local out rc=0
  out=$(plugins/loadout/statusline/statusline.test.sh 2>&1) || rc=$?
  ((rc == 0)) || grep '✗' <<<"$out"
  return "$rc"
}

guard_scan_tests() {  # print only the failed assertions, keep the suite's status
  local out rc=0
  out=$(guard/scan.test.sh 2>&1) || rc=$?
  ((rc == 0)) || grep '✗' <<<"$out"
  return "$rc"
}

budget_tests() {  # print only the failed assertions, keep the suite's status
  local out rc=0
  out=$(scripts/budget.test.sh 2>&1) || rc=$?
  ((rc == 0)) || grep '✗' <<<"$out"
  return "$rc"
}

install_tests() {  # print only the failed assertions, keep the suite's status
  local out rc=0
  out=$(scripts/install.test.sh 2>&1) || rc=$?
  ((rc == 0)) || grep 'FAIL' <<<"$out"
  return "$rc"
}

eval_tests() {  # print only the failed assertions, keep the suite's status
  local out rc=0
  out=$(scripts/eval.test.sh 2>&1) || rc=$?
  ((rc == 0)) || grep '✗' <<<"$out"
  return "$rc"
}

# Published docs against .vale/styles. A planted em-dash must fail first, so a broken
# config can't pass as clean. CI installs vale; a fork without it skips this.
prose_lint() {
  command -v vale >/dev/null || { echo "vale isn't installed, skipped"; return 0; }
  local rc=0
  if printf '# Sample\n\nThis fails \xe2\x80\x94 on purpose.\n' |
    vale --config .vale.ini --ext=.md --output=line >/dev/null 2>&1; then
    echo "vale passed a planted em-dash, so its config is broken"
    return 1
  fi
  vale --config .vale.ini --no-wrap --output=line README.md WRITING-AN-EFFECTIVE-HARNESS.md \
    CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md docs/audit-log.md docs/eval-results.md \
    docs/public-repo-standard.md || rc=$?
  return "$rc"
}

# docs/public-repo-standard.md, the items a script can check. It takes a root, so a
# test can point it at a broken copy.
repo_standard() {
  local r=${1:-.} ok=0 f line
  for f in LICENSE THIRD_PARTY_NOTICES.md REUSE.toml README.md CONTRIBUTING.md CODE_OF_CONDUCT.md SECURITY.md \
    .github/dependabot.yml .github/pull_request_template.md .github/ISSUE_TEMPLATE/bug.yml .github/ISSUE_TEMPLATE/feature.yml; do
    [[ -s $r/$f ]] || { echo "$f is missing"; ok=1; }
  done
  [[ -n $(find "$r/LICENSES" -name '*.txt' -print -quit 2>/dev/null) ]] || { echo "LICENSES/ holds no license text"; ok=1; }
  grep -q '^[[:space:]-]*package-ecosystem: github-actions' "$r/.github/dependabot.yml" 2>/dev/null ||
    { echo "Dependabot doesn't watch github-actions"; ok=1; }
  local workflows=() actions=() value
  mapfile -t workflows < <(find "$r/.github/workflows" -maxdepth 1 -type f \( -name '*.yml' -o -name '*.yaml' \) 2>/dev/null | sort)
  mapfile -t actions < <(find "$r/.github/actions" -type f \( -name 'action.yml' -o -name 'action.yaml' \) 2>/dev/null | sort)
  ((${#workflows[@]})) || { echo "no workflow in .github/workflows"; ok=1; }
  for f in "${workflows[@]}"; do
    grep -q '^permissions:' "$f" || { echo "${f#"$r"/} sets no permissions"; ok=1; }
    if grep -q 'write-all' "$f"; then echo "${f#"$r"/} asks for write-all"; ok=1; fi
  done
  for f in "${workflows[@]}" "${actions[@]}"; do
    # The value alone, without a trailing comment or quotes, so a comment can't pass it.
    while IFS= read -r value; do
      [[ $value == ./* ]] && continue
      [[ $value =~ @[0-9a-f]{40}$ ]] || { echo "${f#"$r"/} has an action not pinned to a commit: $value"; ok=1; }
    done < <(sed -nE "s/^[[:space:]-]*['\"]?uses['\"]?[[:space:]]*:[[:space:]]*['\"]?([^'\" #]+).*/\1/p" "$f")
  done
  return "$ok"
}

repo_standard_negative() {  # the check must fail on a repo that breaks the standard
  local t
  t=$(mktemp -d)
  mkdir -p "$t/.github/workflows"
  printf 'on: push\njobs:\n  a:\n    steps:\n      - uses: actions/checkout@v4\n' >"$t/.github/workflows/ci.yml"
  local out rc=0
  out=$(repo_standard "$t") || rc=$?
  rm -rf "$t"
  ((rc == 1)) || { echo "repo_standard passed a broken repo"; return 1; }
  for w in 'CODE_OF_CONDUCT.md is missing' 'sets no permissions' 'not pinned to a commit'; do
    grep -q "$w" <<<"$out" || { echo "repo_standard missed: $w"; return 1; }
  done
  t=$(mktemp -d)
  mkdir -p "$t/.github/workflows" "$t/.github/actions/x"
  printf 'permissions: {}\njobs:\n  a:\n    steps:\n      - uses: a/b@v4 # was @%040d\n' 0 >"$t/.github/workflows/w.yaml"
  printf 'runs:\n  steps:\n    - uses: c/d@v1\n' >"$t/.github/actions/x/action.yml"
  out=$(repo_standard "$t") || true
  rm -rf "$t"
  for w in 'w.yaml has an action' 'action.yml has an action'; do
    grep -q "$w" <<<"$out" || { echo "repo_standard missed: $w"; return 1; }
  done
  t=$(mktemp -d)
  out=$(repo_standard "$t") || true
  rm -rf "$t"
  grep -q 'no workflow' <<<"$out" || { echo "repo_standard passed a repo with no workflow"; return 1; }
}

# A retro must not depend on someone remembering the log, so a retro with no entry
# fails here. Retros from before the log's first entry are exempt.
audit_log_current() {
  local log=docs/audit-log.md first f day ok=0
  [[ -r $log ]] || { echo "$log is missing"; return 1; }
  first=$(sed -n 's/^## \([0-9-]\{10\}\).*/\1/p' "$log" | sort | head -1)
  [[ -n $first ]] || { echo "$log has no dated entry"; return 1; }
  for f in retros/[0-9]*.md; do
    [[ -e $f ]] || continue
    day=$(basename "$f" .md)
    [[ $day < $first ]] && continue
    grep -q "^## $day" "$log" || { echo "$f has no entry in $log"; ok=1; }
  done
  return "$ok"
}

# retro-evidence on a synthetic home: it must exit 0, find the correction, withhold a
# term hidden in snake_case, camelCase or behind an escape, and read papercut branches.
retro_evidence_test() {
  local t rc=0 out
  t=$(mktemp -d)
  mkdir -p "$t/cfg/projects/-w-app"
  printf '\\bzorblax\\b\n' >"$t/deny"
  local ts; ts=$(date -u +%FT%TZ)
  for c in '"no, fix project_zorblax.md instead"' '"do not rename ZorblaxClient"' '"notes say\\nzorblax here"' '"do not touch the config, use env vars instead"'; do
    printf '{"type":"user","uuid":"%s","sessionId":"%s","timestamp":"%s","entrypoint":"cli","message":{"role":"user","content":%s}}\n' \
      "$RANDOM$RANDOM" "$RANDOM" "$ts" "$c" >"$t/cfg/projects/-w-app/$RANDOM.jsonl"
  done
  # A throwaway repository holding only this script, a main and one papercut branch.
  mkdir -p "$t/repo/scripts" "$t/repo/retros/friction"
  cp "$root/scripts/retro-evidence" "$t/repo/scripts/"
  local g=(git -C "$t/repo" -c user.name=t -c user.email=test@localhost -c core.hooksPath=/dev/null)
  "${g[@]}" init -q -b main && "${g[@]}" add scripts && "${g[@]}" commit -q -m "chore: start"
  "${g[@]}" switch -q -c papercut/check-test
  echo "2026-01-02 a check friction -> logged (none)" >"$t/repo/retros/friction/2026-01-02-check.md"
  "${g[@]}" add retros && "${g[@]}" commit -q -m "test: papercut"
  "${g[@]}" switch -q main
  out=$(HOME=$t CLAUDE_CONFIG_DIR=$t/cfg GUARD_DENYLIST=$t/deny "$t/repo/scripts/retro-evidence" --since 2026-01-01) || rc=$?
  rm -rf "$t"
  ((rc == 0)) || { echo "retro-evidence exited $rc"; return 1; }
  grep -q 'use env vars instead' <<<"$out" || { echo "the correction is missing"; return 1; }
  grep -q 'open branch papercut/check-test' <<<"$out" || { echo "the papercut branch is missing"; return 1; }
  if grep -q -i 'zorblax' <<<"$out"; then echo "a withheld term was printed"; return 1; fi
}

# guard/scan --path on synthetic trees. It must find a term raw, in snake_case, in
# camelCase and inside a binary file; a two-word term in the generator's bracket
# shape, spaced, joined and in camelCase; a term that starts where the home path's
# name would continue; a matching file name, directory name and a name under a
# symlinked directory; an unreadable file, reported as unchecked; and a name with a
# newline, printed as ?. It must number lines as the denylist does, blank lines
# included; pass the home path and its dash-encoded form; exit 0 on a clean tree;
# and run outside a git checkout.
path_scan_test() {
  local t h d out rout lout cout rc=0 lrc=0 crc=0 f scan
  scan=$root/guard/scan
  t=$(mktemp -d)
  h=$t/home-zorblax
  d=$(tr / - <<<"$h")
  mkdir -p "$h/tree/zorblax-notes" "$h/clean"
  printf '\n\\bzorblax\\b\nquux frob\nzorblaxian\n\\bwib[ ._-]?wob\\b\n' >"$t/deny"
  echo nothing >"$h/tree/clean.txt"
  echo "the zorblax plan" >"$h/tree/raw.txt"
  echo "see project_zorblax notes" >"$h/tree/snake.md"
  echo "new ZorblaxClient()" >"$h/tree/camel.ts"
  printf 'a\0zorblax\0b' >"$h/tree/binary.db"
  echo "new QuuxFrob()" >"$h/tree/twoword.ts"
  echo "the wib wob plan" >"$h/tree/bracket-spaced.txt"
  echo "new WibWob()" >"$h/tree/bracket-camel.ts"
  echo "see ${h}ian/notes" >"$h/tree/prefix.txt"
  echo fine >"$h/tree/zorblax-notes/inner.txt"
  echo fine >"$h/tree/zorblax.txt"
  echo "path $h/x, $h. and $d-code-x/y, $d/z" >"$h/tree/home.txt"
  echo zorblax >"$h/tree/$(printf 'new\nline.txt')"
  echo zorblax >"$h/tree/locked.txt" && chmod 000 "$h/tree/locked.txt"
  mkdir -p "$t/elsewhere/zorblax-dir" && ln -s "$t/elsewhere" "$h/tree/link"
  echo fine | gzip >"$h/tree/notes.gz"
  echo "path $h/code" >"$h/clean/a.txt"
  HP=$h perl -e 'print "xxxx $ENV{HP}/code/file\n" x 150000' >"$h/clean/big.log"
  out=$(cd "$t" && HOME=$h GUARD_DENYLIST=$t/deny "$scan" --path "$h/tree" 2>&1) || rc=$?
  rout=$(cd "$h" && HOME=$h GUARD_DENYLIST=$t/deny "$scan" --path tree 2>&1) || true
  lout=$(cd "$t" && HOME=$h GUARD_DENYLIST=$t/deny "$scan" --path "$h/tree/link" 2>&1) || lrc=$?
  cout=$(cd "$t" && HOME=$h GUARD_DENYLIST=$t/deny "$scan" --path "$h/clean" 2>&1) || crc=$?
  chmod 600 "$h/tree/locked.txt"
  rm -rf "$t"
  ((rc == 1)) || { echo "guard/scan --path exited $rc"; return 1; }
  for f in raw.txt snake.md camel.ts binary.db; do
    grep -q "line(s) 2 match inside ~/tree/$f" <<<"$out" || { echo "missed $f or misnumbered it"; return 1; }
  done
  grep -q "line(s) 3 match inside ~/tree/twoword.ts" <<<"$out" || { echo "missed the two-word term"; return 1; }
  for f in bracket-spaced.txt bracket-camel.ts; do
    grep -q "line(s) 5 match inside ~/tree/$f" <<<"$out" || { echo "missed the bracket-shape term in $f"; return 1; }
  done
  grep -q "line(s) 4 match inside ~/tree/prefix.txt" <<<"$out" || { echo "the home rewrite hid a term"; return 1; }
  grep -q 'the name at ~/tree/(withheld)$' <<<"$out" || { echo "a matching name was not withheld"; return 1; }
  [[ $(grep -c 'the name at ~/tree/(withheld)$' <<<"$out") -ge 2 ]] || { echo "the file name and the directory name were not both reported"; return 1; }
  grep -q 'inside ~/tree/new?line.txt' <<<"$out" || { echo "a name with a newline was missed or printed raw"; return 1; }
  if ((EUID != 0)); then
    grep -q 'could not read ~/tree/locked.txt' <<<"$out" || { echo "an unreadable file passed as clean"; return 1; }
    grep -q 'could not read ~/tree/locked.txt' <<<"$rout" || { echo "a relative --path lost the unreadable file's name"; return 1; }
  fi
  ((lrc == 1)) && grep -q 'the name at ~/tree/link/(withheld)' <<<"$lout" || { echo "names under a symlinked directory were not checked"; return 1; }
  ((crc == 0)) || { echo "a clean tree exited $crc (a home path cut by a chunk boundary reads as a match)"; return 1; }
  grep -q '; 1 archives and compressed documents were not opened' <<<"$out" || { echo "the archive was not counted"; return 1; }
  if grep -q -e 'home.txt' -e 'clean.txt' <<<"$out"; then echo "a clean file was reported"; return 1; fi
  if grep -q -i -e 'zorblax' -e 'wib' -e 'quux' <<<"$out$lout"; then echo "a withheld term was printed"; return 1; fi
}

step 'budget lint' scripts/lint-budgets
step 'every plugin has evals' evals_present
step 'identity and secret scan, full history' guard/scan --all
step 'forbidden names' names_allowed
step 'statusline tests' statusline_tests
step 'notify hook tests' notify_tests
step 'gh publication hook tests' gh_hook_tests
step 'guard/scan tests' guard_scan_tests
step 'review gate tests' review_gate_tests
step 'session-start hook tests' session_start_tests
step 'retro-evidence on a synthetic home' retro_evidence_test
step 'guard/scan --path on a synthetic tree' path_scan_test
step 'install layering tests' install_tests
step 'budget script tests' budget_tests
step 'eval wrapper tests' eval_tests
step 'audit log covers every retro' audit_log_current
step 'prose lint' prose_lint
step 'public repo standard' repo_standard
step 'public repo standard catches a broken repo' repo_standard_negative
((ci)) || step 'claude plugin validate' claude plugin validate .

if ((${#failed[@]})); then
  printf 'check: FAILED: %s\n' "${failed[@]}"
  exit 1
fi
echo "check: all passed"
