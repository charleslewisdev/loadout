#!/usr/bin/env bash
# How often sessions read their auto-memory (success criterion S4).
#
#   scripts/memory-reads [days]            default 14
#   scripts/memory-reads --unread <days>   memory files no session read in <days>
#
# Counts Read and Grep calls into any auto-memory directory
# (~/.claude/projects/<project>/memory/) per session, from the transcripts
# ~/.claude/projects/*/*.jsonl modified in the last <days> days. Only interactive
# sessions count: print-mode runs (entrypoint sdk-*), such as evals and
# scripts/budget, are reported as excluded.
#
# Refuses to run without the identity guard's denylist. A project directory whose
# name matches it is skipped whole; inside a transcript, every record that matches
# is withheld and the rest is counted. The script prints numbers only, so it cannot
# copy a private string; scripts that copy text skip whole transcripts instead.
# Before matching, the home path is replaced by ~, and attachment records are
# dropped: they hold the injected user CLAUDE.md, which names the private
# vocabulary in every session.
#
# --unread lists, per project, the memory files (not MEMORY.md) that no
# interactive session read with Read or Grep in the window: the retro's candidates
# for trimming an index. Project and file names that match the denylist are
# withheld.
set -euo pipefail

unread=0
if [[ ${1:-} == --unread ]]; then
  unread=1
  shift
fi
days=${1:-14}
[[ $days =~ ^[0-9]+$ ]] || { echo "usage: scripts/memory-reads [--unread] [days]" >&2; exit 2; }
deny="${GUARD_DENYLIST:-$HOME/.config/loadout-guard/denylist}"
projects="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects"
if [[ ! -r $deny ]]; then
  echo "memory-reads: no denylist at ${deny/#"$HOME"/\~}; refusing to read transcripts" >&2
  exit 2
fi
enc=${HOME//\//-}
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
grep -v -e '^[[:space:]]*$' "$deny" >"$tmp/deny" || true
rc=0
grep -E -f "$tmp/deny" /dev/null || rc=$?
if [[ ! -s $tmp/deny ]] || ((rc > 1)); then
  echo "memory-reads: the denylist is empty or holds an invalid pattern; refusing to read transcripts" >&2
  exit 2
fi

# Auto-memory paths as they read after the home path becomes ~.
memory_re="$(sed 's/[][\.*^$()+?{}|]/\\&/g' <<<"${projects/#"$HOME"/\~}")/[^/]+/memory(/|\$)"
oldest=0 scanned=0 skipped=0 printmode=0 withheld=0 partial=0 with_reads=0 reads=0
: >"$tmp/per-session"
: >"$tmp/read-paths"
for dir in "$projects"/*/; do
  name=$(basename "$dir")
  if grep -q -i -E -f "$tmp/deny" <<<"${name//"$enc"/\~}"; then
    skipped=$((skipped + $(find "$dir" -maxdepth 1 -name '*.jsonl' -mtime "-$days" | wc -l)))
    continue
  fi
  while IFS= read -r t; do
    entry=$(jq -n -r 'first(inputs | .entrypoint // empty) // ""' "$t" 2>/dev/null || true)
    if [[ $entry == sdk* ]]; then
      printmode=$((printmode + 1))
      continue
    fi
    # A corrupt or half-written line ends the conversation early; only what was
    # parsed is matched and counted.
    { jq -c 'select(.type != "attachment")' "$t" 2>/dev/null || true; } |
      sed -e "s|$HOME|~|g" -e "s|$enc|~|g" >"$tmp/records"
    grep -v -i -E -f "$tmp/deny" "$tmp/records" >"$tmp/conversation" || true
    dropped=$(($(wc -l <"$tmp/records") - $(wc -l <"$tmp/conversation")))
    if ((dropped > 0)); then
      withheld=$((withheld + dropped))
      partial=$((partial + 1))
    fi
    scanned=$((scanned + 1))
    { jq -r 'select(.type == "assistant") | .message.content[]?
          | select(.type == "tool_use" and (.name == "Read" or .name == "Grep"))
          | .input.file_path // .input.path // empty' "$tmp/conversation" 2>/dev/null || true; } |
      { grep -E "$memory_re" || true; } >"$tmp/session-paths"
    t_age=$(stat -c %Y "$t" 2>/dev/null || stat -f %m "$t")
    ((oldest == 0 || t_age < oldest)) && oldest=$t_age
    cat "$tmp/session-paths" >>"$tmp/read-paths"
    n=$(wc -l <"$tmp/session-paths")
    echo "$n" >>"$tmp/per-session"
    if ((n > 0)); then
      with_reads=$((with_reads + 1))
      reads=$((reads + n))
    fi
  done < <(find "$dir" -maxdepth 1 -name '*.jsonl' -mtime "-$days")
done

if ((unread)); then
  withhold() { if grep -q -i -E -f "$tmp/deny" <<<"$1"; then printf '(name withheld)'; else printf '%s' "$1"; fi; }
  now=$(date +%s)
  start=$((now - days * 86400))
  echo "Auto-memory files not read by an interactive session in the last $days days, $(date +%F)"
  echo "  (from $scanned sessions; Read or Grep of the file itself counts as a read)"
  covered=$(( oldest > 0 ? (now - oldest) / 86400 : 0 ))
  if ((covered < days)); then
    echo "  Transcripts cover only the last $covered days, so a file listed here was unread in that span only."
  fi
  echo "  Files changed within the window are not judged."
  young=0
  for dir in "$projects"/*/; do
    [[ -d ${dir}memory ]] || continue
    name=$(basename "$dir")
    name=${name//"$enc"/\~}
    grep -q -i -E -f "$tmp/deny" <<<"$name" && continue
    files=() missing=()
    for f in "${dir}"memory/*.md; do
      [[ -f $f && $(basename "$f") != MEMORY.md ]] || continue
      f_age=$(stat -c %Y "$f" 2>/dev/null || stat -f %m "$f")
      if ((f_age > start)); then young=$((young + 1)); continue; fi
      files+=("$f")
      key=$(sed -e "s|$HOME|~|g" -e "s|$enc|~|g" <<<"$f")
      grep -q -x -F -e "$key" "$tmp/read-paths" || missing+=("$(basename "$f")")
    done
    ((${#files[@]})) || continue
    echo "  $(withhold "$name"): ${#missing[@]} of ${#files[@]} files unread"
    for m in "${missing[@]}"; do echo "    $(withhold "$m")"; done
  done
  echo "  $young files changed within the window, not judged."
  exit 0
fi

mkdir -p "${LOADOUT_CACHE:-$HOME/.cache/loadout}"
exec > >(tee "${LOADOUT_CACHE:-$HOME/.cache/loadout}/memory-reads")
echo "Auto-memory reads, last $days days, $(date +%F)"
echo "  sessions scanned            $scanned"
echo "  sessions in skipped dirs    $skipped"
echo "  records withheld (denylist) $withheld, from $partial sessions"
echo "  print-mode runs excluded    $printmode"
echo "  sessions with a memory read $with_reads"
echo "  Read and Grep calls         $reads"
if ((scanned > 0)); then
  awk -v r="$reads" -v s="$scanned" 'BEGIN { printf "  reads per session           %.3f\n", r / s }'
  echo "  distribution (reads: sessions)  $(sort -n "$tmp/per-session" | uniq -c | awk '{ printf "%s: %s  ", $2, $1 }')"
fi
