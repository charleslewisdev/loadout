#!/usr/bin/env bash
# Turn-0 token cost of this machine's Claude Code setup.
#
#   scripts/budget [--project <dir>] [--runs <n>]
#
# Sends one fixed prompt to Haiku in a fresh temp directory and sums input_tokens,
# cache_creation_input_tokens and cache_read_input_tokens from `usage`. Each
# configuration gets n usable runs (default 3):
#
#   as configured     nothing added
#   auto-memory off   CLAUDE_CODE_DISABLE_AUTO_MEMORY=1
#   no connectors     auto-memory off, plus an empty strict MCP config
#   vendor floor      --safe-mode
#
# Harness share is auto-memory off minus the floor, checked against the ceiling
# at its highest, with connectors in it. Connectors race the first request, so
# those runs carry a silent SessionStart hook that holds the request until they
# connect, at no token cost. The log still decides: a run counts only when it shows
# the most deferred tools seen for that configuration, above the no-connectors
# count. Other runs are discarded and repeated. If connectors never arrive it exits
# 2 and keeps the last good result.
#
# Cost by surface comes from one on and off difference each, so no real setting
# changes: every connector, the account-synced skills and every enabled plugin with
# --settings, and the user CLAUDE.md with an environment variable. Connector names
# can be private, so keep this output out of public text unless they are removed.
#
# Exits 0 within the ceiling, 1 over it, and 2 if nothing could be measured. A
# failed connector, or a `claude mcp list` it can't read, is an exit 2.
#
# --project repeats the four configurations in <dir>, so its CLAUDE.md and memory
# index are counted. The result is cached in ~/.cache/loadout/budget.
set -euo pipefail

ceiling=6000
absolute=8000
runs=3
max_batches=8  # a batch is one round of parallel runs
hold=2  # seconds the first request waits for connectors
project=''
while [[ $# -gt 0 ]]; do
  case $1 in
    --project) project=$(cd "$2" && pwd); shift 2 ;;
    --runs) runs=$2; shift 2 ;;
    -h | --help) sed -n '2,32s/^# \{0,1\}//p' "$0"; exit 0 ;;
    *) echo "usage: scripts/budget [--project <dir>] [--runs <n>]" >&2; exit 2 ;;
  esac
done

prompt='Reply with exactly the word OK and nothing else.'
tmp=$(mktemp -d)
# Auto-memory creates an empty project directory for each measured directory;
# rmdir removes it only while it is still empty.
config=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
projects=$config/projects
cleanup() {
  local d
  for d in "$tmp/empty" ${project:+"$project"}; do
    d="$projects/$(sed 's|[/.]|-|g' <<<"$d")"
    if [[ $d == "$projects/-tmp-"* ]]; then rmdir "$d/memory" "$d" 2>/dev/null || true; fi
  done
  rm -rf "$tmp"
}
trap cleanup EXIT

# A child of a running session inherits that session's variables. Drop them so
# the numbers match a run from a plain terminal.
clean=()
for v in $(compgen -e); do
  case $v in
    CLAUDECODE | CLAUDE_PID | CLAUDE_EFFORT | CLAUDE_CODE_SESSION_* | CLAUDE_CODE_CHILD_SESSION | \
      CLAUDE_CODE_MESSAGING_* | CLAUDE_CODE_BRIDGE_* | CLAUDE_CODE_ENTRYPOINT | CLAUDE_CODE_EXECPATH | \
      CLAUDE_CODE_SSE_PORT) clean+=(-u "$v") ;;
  esac
done

commas() { perl -pe '1 while s/^(-?\d+)(\d{3})/$1,$2/' <<<"$1"; }
tilde() { printf '%s' "${1/#"$HOME"/\~}"; }

die() { echo "budget: $*" >&2; exit 2; }  # measurement failed: no result to report

tokens() { jq '.usage | .input_tokens + .cache_creation_input_tokens + .cache_read_input_tokens' "$1"; }

# deferred <log>: deferred-tool count of the run's first request, 0 if it logged none.
deferred() {
  local n
  n=$(sed -n '/Dynamic tool loading: [0-9]*\/[0-9]* deferred/{s/.*\/\([0-9]*\) deferred.*/\1/p;q;}' "$1")
  echo "${n:-0}"
}

# measure <label> <dir> <arrival> <env or ''> [flags]: runs in parallel batches and
# writes "min max" to $tmp/<label>.range, keeping each run's JSON and debug log.
# With arrival=1 only runs that reached the top deferred count are kept, and it
# returns 1 if fewer than $runs did. <env> is split on spaces.
measure() {
  local label=$1 dir=$2 arrival=$3 assign=$4 done=0 batch i top kept
  shift 4
  echo "budget: $label" >&2
  for ((batch = 1; batch <= max_batches; batch++)); do
    for ((i = done + 1; i <= done + runs; i++)); do
      # shellcheck disable=SC2086  # assign is one or more VAR=value words
      (cd "$dir" && env "${clean[@]}" $assign claude -p "$prompt" --model haiku \
        --output-format json --no-session-persistence --debug-file "$tmp/$label.$i.log" "$@" \
        </dev/null >"$tmp/$label.$i.json" 2>"$tmp/$label.$i.err") &
    done
    wait
    for ((i = done + 1; i <= done + runs; i++)); do
      if ! jq -e '(.is_error | not) and (.usage.input_tokens != null)' "$tmp/$label.$i.json" >/dev/null 2>&1; then
        echo "budget: run $i of '$label' failed:" >&2
        cat "$tmp/$label.$i.json" "$tmp/$label.$i.err" >&2
        exit 2
      fi
      echo "$(deferred "$tmp/$label.$i.log") $(tokens "$tmp/$label.$i.json")" >>"$tmp/$label.samples"
    done
    done=$((done + runs))
    top=$(sort -n "$tmp/$label.samples" | tail -1 | cut -d' ' -f1)
    kept=$(awk -v t="$top" '$1 == t { n++ } END { print n + 0 }' "$tmp/$label.samples")
    if ((!arrival)); then
      cut -d' ' -f2 "$tmp/$label.samples" | sort -n | sed -n '1p;$p' | paste -sd' ' - >"$tmp/$label.range"
      echo "$top" >"$tmp/$label.top"
      return 0
    fi
    if ((top > base_deferred && kept >= runs)); then
      awk -v t="$top" '$1 == t { print $2 }' "$tmp/$label.samples" | sort -n | sed -n '1p;$p' |
        paste -sd' ' - >"$tmp/$label.range"
      missed_runs=$((missed_runs + done - kept))
      return 0
    fi
  done
  return 1
}

low() { cut -d' ' -f1 "$tmp/$1.range"; }
range() { if [[ $1 == "$2" ]]; then commas "$1"; else echo "$(commas "$1") to $(commas "$2")"; fi; }

# block <dir> <tag>: measures the four configurations in <dir> and prints them.
block() {
  local dir=$1 tag=$2
  measure "$tag-no-connectors" "$dir" 0 CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 "${strict_mcp[@]}"
  base_deferred=$(<"$tmp/$tag-no-connectors.top")
  measure "$tag-configured" "$dir" "$wait_for_connectors" '' "${hold_flags[@]}" ||
    die "connectors never arrived in $((max_batches * runs)) runs of 'as configured'"
  measure "$tag-automem-off" "$dir" "$wait_for_connectors" CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 "${hold_flags[@]}" ||
    die "connectors never arrived in $((max_batches * runs)) runs of 'auto-memory off'"
  measure "$tag-floor" "$dir" 0 '' --safe-mode
  read -r c_lo c_hi <"$tmp/$tag-configured.range"
  read -r a_lo a_hi <"$tmp/$tag-automem-off.range"
  read -r n_lo n_hi <"$tmp/$tag-no-connectors.range"
  read -r f_lo f_hi <"$tmp/$tag-floor.range"
  share_lo=$((a_lo - f_hi)) share_hi=$((a_hi - f_lo))
  share_nc_lo=$((n_lo - f_hi)) share_nc_hi=$((n_hi - f_lo))
  mem_lo=$((c_lo - a_hi)) mem_hi=$((c_hi - a_lo))
  configured_lo=$c_lo configured_hi=$c_hi automem_off_lo=$a_lo automem_off_hi=$a_hi floor_lo=$f_lo floor_hi=$f_hi
  printf '  %-17s %s\n' 'as configured' "$(range "$c_lo" "$c_hi")"
  printf '  %-17s %s\n' 'auto-memory off' "$(range "$a_lo" "$a_hi")"
  printf '  %-17s %s\n' 'no connectors' "$(range "$n_lo" "$n_hi")"
  printf '  %-17s %s  (--safe-mode)\n' 'vendor floor' "$(range "$f_lo" "$f_hi")"
  printf '  %-17s %s  (as configured minus auto-memory off; outside the ceiling)\n' \
    'auto-memory' "$(range "$mem_lo" "$mem_hi")"
  printf '  %-17s %s  (auto-memory off minus the floor)\n' 'harness share' "$(range "$share_lo" "$share_hi")"
  printf '  %-18s %s  (no connectors minus the floor)\n' 'without connectors' "$(range "$share_nc_lo" "$share_nc_hi")"
}

version=$(claude --version | awk '{print $1}')
echo "Turn-0 tokens, Claude Code $version, Haiku, $runs usable runs each, $(date +%F)"
echo "Directory: a fresh empty temp directory"
mkdir "$tmp/empty"

strict_mcp=(--strict-mcp-config --mcp-config '{"mcpServers":{}}')
mcp_list=$(cd "$tmp/empty" && env "${clean[@]}" claude mcp list 2>/dev/null) || die "claude mcp list failed"
connector_names=() connector_states=() ready=0
while IFS=$'\t' read -r name state; do
  connector_names+=("$name")
  connector_states+=("$state")
  [[ $state == ✔ ]] && ready=$((ready + 1))
  # A failed connector drops out of the share, so an outage would read as a pass.
  [[ $state == ✘ ]] && die "$name failed to connect; fix or remove it, then measure again. The last good result stands."
done < <(perl -ne 'print "$1\t$2\n" if /^(.+?): .+ - (✔|✘|!)/' <<<"$mcp_list")
# Any other line means the format changed: an empty parse must not read as no connectors.
listed=$(grep -cvE '^$|^Checking MCP|^No MCP servers' <<<"$mcp_list" || true)
((listed == ${#connector_names[@]})) || die "could not read 'claude mcp list': $listed lines, ${#connector_names[@]} understood"
wait_for_connectors=0 hold_settings='{}' hold_flags=()
if ((ready > 0)); then
  wait_for_connectors=1
  hold_settings=$(jq -nc --arg c "sleep $hold" '{hooks: {SessionStart: [{hooks: [{type: "command", command: $c}]}]}}')
  hold_flags=(--settings "$hold_settings")
fi
missed_runs=0

block "$tmp/empty" empty

echo "  Cost by surface, one on and off difference each"
memory_off=$(low empty-automem-off)
without=$(low empty-no-connectors)
connectors=$((memory_off - without))
printf '    %-27s %s\n' connectors "$(commas "$connectors")"
connector_lines=() split=0
for idx in "${!connector_names[@]}"; do
  name=${connector_names[idx]}
  # Waiting makes sense only while another connector can still arrive.
  others=$ready
  [[ ${connector_states[idx]} == ✔ ]] && others=$((others - 1))
  arrival=$((others > 0 ? 1 : 0))
  deny=$(jq -c --arg n "$name" '. + {deniedMcpServers: [{serverName: $n}]}' <<<"$hold_settings")
  if measure "connector-$idx" "$tmp/empty" "$arrival" CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 --settings "$deny"; then
    cost=$((memory_off - $(low "connector-$idx")))
    split=$((split + cost))
    printf '      %-25s %s\n' "$name" "$(commas "$cost")"
    connector_lines+=("connector.$name=$cost")
  else
    printf '      %-25s unmeasured: the others never arrived\n' "$name"
  fi
done
shared=$((connectors - split))
((shared > 4)) && printf '      %-25s %s\n' shared "$(commas "$shared")"

# The surfaces below are measured with connectors off, so no run can miss them.
parts=0
surface() {  # surface <label> <cost> [note]
  parts=$((parts + $2))
  printf '    %-27s %s%s\n' "$1" "$(commas "$2")" "${3:+  ($3)}"
}
surface_cost() { echo $((without - $(low "$1"))); }

synced_skills=()
while IFS= read -r f; do
  synced_skills+=("$(basename "$(dirname "$f")")")
done < <(find "$config/skills/synced" -mindepth 2 -name SKILL.md 2>/dev/null)
synced_cost=0
if ((${#synced_skills[@]})); then
  off=$(printf '%s\n' "${synced_skills[@]}" | jq -Rnc '{skillOverrides: (reduce inputs as $s ({}; .[$s] = "off"))}')
  measure synced "$tmp/empty" 0 CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 "${strict_mcp[@]}" --settings "$off"
  synced_cost=$(surface_cost synced)
  surface 'synced skills' "$synced_cost" "${#synced_skills[@]} skills"
fi

plugin_lines=() plugins=()
mapfile -t plugins < <(jq -r '.enabledPlugins // {} | to_entries[] | select(.value != false) | .key' \
  "$config/settings.json" 2>/dev/null || true)
idx=0
for plugin in "${plugins[@]}"; do
  idx=$((idx + 1))
  disable=$(jq -nc --arg p "$plugin" '{enabledPlugins: {($p): false}}')
  measure "plugin-$idx" "$tmp/empty" 0 CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 "${strict_mcp[@]}" --settings "$disable"
  cost=$(surface_cost "plugin-$idx")
  surface "$plugin" "$cost"
  plugin_lines+=("plugin.$plugin=$cost")
done

measure claude-md "$tmp/empty" 0 'CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 CLAUDE_CODE_DISABLE_CLAUDE_MDS=1' "${strict_mcp[@]}"
claude_md_cost=$(surface_cost claude-md)
surface 'user CLAUDE.md' "$claude_md_cost"
rest=$((without - $(low empty-floor) - parts))
printf '    %-27s %s  (personal skills and the rest, by subtraction)\n' rest "$(commas "$rest")"

listing=''
read -r listing_skills listing_chars listing_budget < <(cat "$tmp"/empty-configured.*.log |
  sed -n 's/.*Skill listing over budget: \([0-9]*\) skills, \([0-9]*\) chars > \([0-9]*\) budget.*/\1 \2 \3/p' |
  awk 'NR == 1') || true
[[ -n ${listing_budget:-} ]] && listing="$listing_skills skills, $listing_chars characters against a budget of $listing_budget"
[[ -n $listing ]] && printf '  %-17s %s, so descriptions are truncated\n' 'skill listing' "$(commas "$listing")"

spread=$(cat "$tmp"/*.range | awk '$2 - $1 > s { s = $2 - $1 } END { print s + 0 }')
printf '  Agreement: %s runs discarded for missing connectors; widest spread within a configuration: %s\n' \
  "$missed_runs" "$spread"

if ((share_hi <= ceiling)); then
  result=pass
  echo "PASS: highest harness share $(commas "$share_hi") is within the $(commas $ceiling) ceiling"
elif ((share_hi <= absolute)); then
  result=fail
  echo "FAIL: highest harness share $(commas "$share_hi") is over the $(commas $ceiling) ceiling (absolute $(commas $absolute))"
else
  result=fail
  echo "FAIL: highest harness share $(commas "$share_hi") is over the absolute ceiling of $(commas $absolute)"
fi

cache="${LOADOUT_CACHE:-$HOME/.cache/loadout}"
mkdir -p "$cache"
{
  echo "date=$(date -u +%FT%TZ)"
  echo "epoch=$(date +%s)"
  echo "claude_version=$version"
  echo "runs=$runs"
  echo "configured=$configured_lo-$configured_hi"
  echo "automemory_off=$automem_off_lo-$automem_off_hi"
  echo "floor=$floor_lo-$floor_hi"
  echo "automemory=$mem_lo-$mem_hi"
  echo "share=$share_lo-$share_hi"
  echo "share_without_connectors=$share_nc_lo-$share_nc_hi"
  echo "connectors=$connectors"
  echo "synced_skills=$synced_cost"
  echo "claude_md=$claude_md_cost"
  echo "rest=$rest"
  ((${#connector_lines[@]})) && printf '%s\n' "${connector_lines[@]}"
  ((${#plugin_lines[@]})) && printf '%s\n' "${plugin_lines[@]}"
  echo "missed_runs=$missed_runs"
  echo "spread=$spread"
  echo "ceiling=$ceiling"
  [[ -n $listing ]] && printf 'listing_skills=%s\nlisting_chars=%s\nlisting_budget=%s\n' "$listing_skills" "$listing_chars" "$listing_budget"
  echo "result=$result"
} >"$cache/budget"

if [[ -n $project ]]; then
  empty_hi=$configured_hi empty_lo=$configured_lo
  echo
  echo "Directory: $(tilde "$project")"
  block "$project" project
  printf '  %-17s %s  (as configured, over the empty directory)\n' 'project context' \
    "$(range $((configured_lo - empty_hi)) $((configured_hi - empty_lo)))"
fi

[[ $result == pass ]]
