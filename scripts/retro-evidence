#!/usr/bin/env bash
# Transcript evidence for the retro: the author's corrections, and prompts repeated
# across sessions.
#
#   scripts/retro-evidence [--since <yyyy-mm-dd>]
#
# Default window: since the last retros/<date>.md, else 90 days. Reads interactive
# sessions only (print-mode runs, entrypoint sdk-*, are excluded). The retro copies
# this text into a pull request, so it skips every project directory and every
# whole transcript that matches the identity guard's denylist, and refuses to run
# without a valid one. Home paths become ~.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
since=''
if [[ ${1:-} == --since ]]; then since=${2:-}; fi
if [[ -z $since ]]; then
  last=$(ls "$root"/retros/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].md 2>/dev/null | sort | tail -1) || true
  since=${last:+$(basename "$last" .md)}
fi
if [[ -n $since ]]; then
  [[ $since =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || { echo "usage: scripts/retro-evidence [--since yyyy-mm-dd]" >&2; exit 2; }
  newer=(-newermt "$since")
else
  newer=(-mtime -90)
fi

deny="${GUARD_DENYLIST:-$HOME/.config/loadout-guard/denylist}"
projects="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
grep -v -e '^[[:space:]]*$' "$deny" >"$tmp/deny" 2>/dev/null || true
rc=0
grep -E -f "$tmp/deny" /dev/null 2>/dev/null || rc=$?
if [[ ! -s $tmp/deny ]] || ((rc > 1)); then
  echo "retro-evidence: no valid denylist at ${deny/#"$HOME"/\~}; refusing to read transcripts" >&2
  exit 2
fi
enc=${HOME//\//-}

read_n=0 skipped=0 printmode=0
: >"$tmp/prompts"
for dir in "$projects"/*/; do
  [[ -d $dir ]] || continue
  name=$(basename "$dir")
  name=${name//"$enc"/\~}
  if grep -q -i -E -f "$tmp/deny" <<<"$name"; then
    skipped=$((skipped + $(find "$dir" -maxdepth 1 -name '*.jsonl' "${newer[@]}" | wc -l)))
    continue
  fi
  while IFS= read -r t; do
    entry=$(jq -n -r 'first(inputs | .entrypoint // empty) // ""' "$t" 2>/dev/null || true)
    if [[ $entry == sdk* ]]; then printmode=$((printmode + 1)); continue; fi
    { jq -c 'select(.type != "attachment")' "$t" 2>/dev/null || true; } |
      sed -e "s|$HOME|~|g" -e "s|$enc|~|g" >"$tmp/records"
    if grep -q -i -E -f "$tmp/deny" "$tmp/records"; then skipped=$((skipped + 1)); continue; fi
    read_n=$((read_n + 1))
    day=$(date -r "$t" +%F)
    # Typed prompts only: no tool results, no injected text, no command echoes.
    jq -r --arg p "$name" --arg d "$day" --arg s "$read_n" '
      select(.type == "user" and (.isMeta | not))
      | .message.content
      | (if type == "string" then . else ([.[]? | select(.type == "text") | .text] | join(" ")) end)
      | select(length > 0 and (startswith("<") | not))
      | gsub("\\s+"; " ") | .[0:240]
      | "\($s)\t\($d)\t\($p)\t\(.)"' "$tmp/records" 2>/dev/null >>"$tmp/prompts" || true
  done < <(find "$dir" -maxdepth 1 -name '*.jsonl' "${newer[@]}")
done

echo "Retro evidence since ${since:-90 days ago}: $read_n sessions read, $skipped skipped (denylist), $printmode print-mode runs excluded"
echo
echo "## Corrections (the author redirecting the model)"
grep -i -E $'\t[^\t]*\\b(no[,.]|don\'t|do not|stop|wrong|instead|actually|not what|i said|again|revert|undo|why did you)' "$tmp/prompts" |
  awk -F'\t' '{ printf "- %s %s: %s\n", $2, $3, $4 }' | head -60 || true
echo
echo "## Repeated in two or more sessions"
awk -F'\t' '{ k = tolower($4); gsub(/[^a-z0-9 ]/, "", k); gsub(/ +/, " ", k); k = substr(k, 1, 80)
             if (length(k) < 12) next; if (!((k, $1) in seen)) { seen[k, $1] = 1; n[k]++; ex[k] = $4 } }
     END { for (k in n) if (n[k] > 1) printf "%d\t%s\n", n[k], ex[k] }' "$tmp/prompts" |
  sort -rn | head -30 | awk -F'\t' '{ printf "- %d sessions: %s\n", $1, $2 }' || true
